{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../shared",
  "installCommand": "cd .. && npm ci",
  "buildCommand": "cd .. && npm run build --workspace=shared",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/cron/discovery", "schedule": "*/30 * * * *" }]
}
