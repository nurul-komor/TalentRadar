MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=job_hunter
JWT_SECRET=change-me-in-dev
# Checked against the Authorization header Vercel Cron sends when it calls /cron/*
CRON_SECRET=change-me-in-dev
PORT=8787
# Comma-separated list of origins allowed to call the API (CORS)
DASHBOARD_URL=http://localhost:5173
# --- LLM provider selection ---
# Which provider powers the AI routes (/scoring, /materials, resume auto-fill).
# "anthropic" (default), "openai", or "gemini". The matching API key below must be set,
# or those routes are disabled.
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini (used when LLM_PROVIDER=gemini; GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=your-gemini-key-here

# Optional per-capability model overrides (default to each provider's sensible picks:
# anthropic -> claude-haiku-4-5 / claude-haiku-4-5 / claude-opus-4-8;
# openai    -> gpt-4o-mini for all three;
# gemini    -> gemini-2.0-flash for all three).
# LLM_MODEL_RESUME=
# LLM_MODEL_REQUIREMENTS=
# LLM_MODEL_MATERIALS=

# --- Semantic job suggestions (/suggestions, MongoDB vector search) ---
# Embeddings always use OpenAI (Anthropic has no embeddings API), so OPENAI_API_KEY above
# must be set for /suggestions regardless of LLM_PROVIDER. When unset, /suggestions is
# disabled. $vectorSearch requires MongoDB Atlas; on a non-Atlas MONGODB_URI the feature
# transparently falls back to in-memory cosine similarity.
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIMENSIONS=1536

# Spend caps shared across all providers. LLM_* takes precedence; ANTHROPIC_* kept for
# backward compatibility.
LLM_DAILY_BUDGET_USD=1
LLM_MONTHLY_BUDGET_USD=20
ANTHROPIC_DAILY_BUDGET_USD=1
ANTHROPIC_MONTHLY_BUDGET_USD=20

# --- Cloudinary (stores the original uploaded CV binary) ---
# Set either CLOUDINARY_URL, or the three discrete vars below. When unset, CV
# uploads still work — only the original file isn't stored (cvText still is).
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
