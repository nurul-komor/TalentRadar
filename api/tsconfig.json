{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // src plus the serverless entry (api/index.ts). The entry must be type-checked
  // here — it wires the app together and previously shipped a wrong argument to
  // mountRoutes (a bare LlmConfig instead of the AiRuntime holder) that 500'd
  // /admin/settings/ai, undetected because it sat outside the program. Tests are
  // still excluded (they fail to resolve @job-hunter/shared on a cold Vercel
  // build and break the deploy) and are type-checked via tsconfig.test.json.
  "include": ["src", "api"]
}
